# Server
HOST=0.0.0.0
PORT=8100
DEBUG=true

# CD Builder paths
TEMP_DIR=/tmp/bluepacs_cd
OHIF_VIEWER_PATH=../cd_template/viewer
KPACS_TEMPLATE_PATH=../cd_template/kpacs
LAUNCHER_PATH=../launcher/build

# DICOM nodes are configured in dicom_nodes.json
# When running in Docker, use host.docker.internal to reach host services
# When running locally, use 127.0.0.1

# Orthanc REST HTTP Basic (optional). Overrides orthanc_user / orthanc_password on a node if set.
ORTHANC_USER=
ORTHANC_PASSWORD=
