# Server
HOST=0.0.0.0
PORT=8100
DEBUG=true

# CD Builder paths
TEMP_DIR=/tmp/bluepacs_cd
# Standalone OHIF viewer binaries (macos_view, linux_view, windows_view.exe) plus
# the study/ placeholder. Populate with ./scripts/sync_standalone.sh
# (see cd_template/standalone/README.md).
STANDALONE_VIEWER_PATH=../cd_template/standalone
KPACS_TEMPLATE_PATH=../cd_template/kpacs

# DICOM nodes:
#   - dicom_nodes.json  → local BLUEPACS_CD listener only (ae_title + port).
#   - Remote node list  → fetched live from Ultramar's dicom_modalities table
#                         via ULTRAMAR_NODES_URL (CRUD happens in Uploader
#                         → User Menu → Settings → Pacs Yerleri).
# When empty, services/ultramar_nodes falls back to dicom_nodes.sample.json
# so local dev still works without the PHP backend.
ULTRAMAR_NODES_URL=

# Optional path override for the dev-only sample list (default: backend/dicom_nodes.sample.json).
# ULTRAMAR_NODES_SAMPLE=

# Ultramar phpapi: validates PHP session + PRIVILEGES::P_CAN_USE_CD_CREATION.
# Empty = skip auth (local dev).
CD_AUTH_VALIDATE_URL=

# Orthanc REST HTTP Basic (optional). Overrides orthanc_user / orthanc_password on a node if set.
ORTHANC_USER=
ORTHANC_PASSWORD=
